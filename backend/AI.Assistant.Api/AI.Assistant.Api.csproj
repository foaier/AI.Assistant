<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AI.Assistant</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SqlSugarCore" Version="5.1.4.221" />
    <PackageReference Include="Qdrant.Client" Version="1.19.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.31" />
  </ItemGroup>
  <ItemGroup>
    <!--
      活动和日程工具仅保留为参考实现，依赖未引入的原业务模块，不参与独立项目编译。
      移动该文件时，需要同步更新此处的排除路径。
    -->
    <Compile Remove="Services/Repositorys/AssistantPublicFactToolHandlers.cs" />
    <Content Include="Migrations/*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

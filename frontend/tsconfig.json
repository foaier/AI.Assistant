{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["client/*"] },
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["client", "e2e", "playwright.config.ts", "vite.config.ts", "vitest.config.ts", "tailwind.config.ts"]
}
